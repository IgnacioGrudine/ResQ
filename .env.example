# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# ── Backend runtime ─────────────────────────────────────────────────────────────
# Development localmente (default). En producción, poné Production — evita que
# el backend devuelva stack traces detallados en las respuestas de error.
ASPNETCORE_ENVIRONMENT=Development

# ── Caddy (TLS) ───────────────────────────────────────────────────────────────
# Dejar vacío en dev local (Caddy sirve http://localhost sin certificado).
# En producción: el dominio real, ej. resq.com.ar — Caddy provisiona HTTPS solo.
DOMAIN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=resq
POSTGRES_PASSWORD=resq_dev
POSTGRES_DB=resq_db

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=resq_minio
MINIO_SECRET_KEY=resq_minio_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
# Usar un valor DISTINTO por entorno (dev y producción no deben compartir clave).
JWT_SECRET_KEY=

# ── Google Maps ───────────────────────────────────────────────────────────────
# Se inyecta en el build del frontend para Static Maps + Places Autocomplete.
GOOGLE_MAPS_API_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_ADMIN_ACCESS_TOKEN=
MP_FRONTEND_BASE_URL=
MP_REDIRECT_URI=
MP_NOTIFICATION_URL=
MP_USE_TEST_MODE=false

# ── Encryption (AES-256) ──────────────────────────────────────────────────────
# Generar con: $bytes = New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes); [Convert]::ToBase64String($bytes)
ENCRYPTION_KEY=

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ResQ
