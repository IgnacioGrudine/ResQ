# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# ── Caddy (TLS) ───────────────────────────────────────────────────────────────
# Dejar vacío en dev local (Caddy sirve http://localhost sin certificado).
# En producción: el dominio real, ej. resq.com.ar — Caddy provisiona HTTPS solo.
DOMAIN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=resq
POSTGRES_PASSWORD=resq_dev
POSTGRES_DB=resq_db

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=resq_minio
MINIO_SECRET_KEY=resq_minio_secret

# ── Google Maps ───────────────────────────────────────────────────────────────
# Se inyecta en el build del frontend para Static Maps + Places Autocomplete.
GOOGLE_MAPS_API_KEY=

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=
MP_ADMIN_ACCESS_TOKEN=
MP_REDIRECT_URI=
MP_NOTIFICATION_URL=

# ── Encryption (AES-256) ──────────────────────────────────────────────────────
# Generar con: $bytes = New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes); [Convert]::ToBase64String($bytes)
ENCRYPTION_KEY=
