# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=resq
POSTGRES_PASSWORD=resq_dev
POSTGRES_DB=resq_db

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=resq_minio
MINIO_SECRET_KEY=resq_minio_secret

# ── Google Maps ───────────────────────────────────────────────────────────────
# Se inyecta en el build del frontend para Static Maps + Places Autocomplete.
GOOGLE_MAPS_API_KEY=
